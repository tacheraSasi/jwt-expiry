{
  "name": "jwt-expiry",
  "description": "A lightweight utility to check if a JWT token has expired.",
  "version": "1.0.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tacheraSasi/jwt-expiry.git"
  },
  "bugs": {
    "url": "https://github.com/tacheraSasi/jwt-expiry/issues"
  },
  "license": "MIT",
  "author": "Tachera Sasi <tacherasasi@gmail.com>",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "jwt",
    "jwt-decode",
    "token",
    "expiry",
    "expired",
    "authentication",
    "typescript"
  ],
  "dependencies": {
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "tsup": "^8.4.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
